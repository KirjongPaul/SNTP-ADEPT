      (?catch "i: 1645 setq Project-4.lsp " '; -L1645
        (setq *Салютность-Правил*
              (subst (list Имя-Правила Приоритет) 
                     (assoc Имя-Правила *Салютность-Правил*)
                     *Салютность-Правил*))
