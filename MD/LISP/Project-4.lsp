(defun -> (Данные Элемент Стек_Контекста / This ЭлементRet Список-Правил Список-Данных Ключ-Вызова) ; -L216
  "Вызов метода объекта с данными
  
  Параметры:
    Данные - объект в формате '(Имя-Класса (Список-Атрибутов))
    Элемент - имя вызываемого метода
    Стек_Контекста - список локальных переменных '((Параметр Значение))
  
  Возвращает: результат выполнения метода
  
  Поддерживает защиту от бесконечной рекурсии через проверку глубины
  и обнаружение циклических вызовов"
  
  (?catch "i: 217 -> Project-4.lsp " '; -L217
    (progn ; -L218
      ; Проверка глубины рекурсии
      (cond ; -L220
        ((> *Уровень-Рекурсии* *Макс-Глубина-Рекурсии*) ; -L221
          (progn ; -L222
            (?princ (strcat "\n[ОШИБКА] Превышена максимальная глубина рекурсии: " 
                           (itoa *Уровень-Рекурсии*) 
                           " (максимум: " 
                           (itoa *Макс-Глубина-Рекурсии*) ")"))
            (setq ЭлементRet nil)  ; Возврат nil при ошибке
          ) ;end progn L228
        ) ;end cond case L229
        (T ; -L230
          (progn ; -L231
            ; Проверка на циклические вызовы (если включен Trampoline)
            (if *Использовать-Trampoline* ; -L233
              (progn ; -L234
                (setq Ключ-Вызова (list (car Данные) Элемент))
                (if (member Ключ-Вызова *История-Вызовов*) ; -L237
                  (progn ; -L238
                    (if *isDebug* ; -L239
                      (?princ (strcat "\n[ПРЕДУПРЕЖДЕНИЕ] Обнаружен циклический вызов: " 
                                    (vl-symbol-name (car Данные)) " -> " 
                                    (vl-symbol-name Элемент)))
                    ) ;end if L243
                    (setq ЭлементRet nil)
                  ) ;end progn L245
                  (setq *История-Вызовов* (cons Ключ-Вызова *История-Вызовов*))
                ) ;end if L248
              ) ;end progn L234
            ) ;end if L233
            
            (if (NULL ЭлементRet) ; -L252
              (progn ; -L253
                (setq *Уровень-Рекурсии* (+ *Уровень-Рекурсии* 1))
    
                (Print-IGraf Элемент 3)
                
                ; Извлечение списка данных
                (setq Список-Данных (cadr Данные))
                (if (and Список-Данных (/= (type (nth 0 Список-Данных)) 'LIST)) ; -L261
                  (setq Список-Данных nil)
                ) ;end if L263
                
                ; Формирование контекста This
                (setq This (list 'This (list (list (reverse Список-Данных) (reverse Список-Правил)))))
                
                ; Поиск и выполнение метода
                (setq ЭлементRet (::Do-Poisk))
                
                ; Восстановление состояния
                (setq *Уровень-Рекурсии* (- *Уровень-Рекурсии* 1))
                (if *Использовать-Trampoline* ; -L274
                  (setq *История-Вызовов* (cdr *История-Вызовов*))
                ) ;end if L276
                
                (Print-IGraf ЭлементRet 4)
              ) ;end progn L253
            ) ;end if L252
          ) ;end progn L231
        ) ;end cond case L281
      ) ;end cond L282
      
      ; Возврат результата
      (if ЭлементRet ; -L285
        (cadr ЭлементRet)
        nil
      ) ;end if L288
    ) ;end progn L218
  ) ;end ?catch L217
) ;end defun -> L216
(?log "L: 367 Project-4.lsp -> => ")

