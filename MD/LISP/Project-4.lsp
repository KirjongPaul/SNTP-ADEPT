      ) ;end cond case L1753
      (T ; -L1754
        ; По умолчанию - порядок списка
        Список-Правил
      ) ;end cond case L1757
    ) ;end cond L1758
  ) ;end ?catch L1759
) ;end defun Сортировать-Правила-По-Стратегии L1760
