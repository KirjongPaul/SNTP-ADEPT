(defun Print-IGraf (Элемент Mode / @Per @Per-1 iGraf iStr) ; -L105
  "Вывод графа выполнения для отладки"
  (?catch "i: 106 Print-IGraf Project-4.lsp " '; -L106
    (progn ; -L107
      (if (not (NULL *isGraf*)) ; -L108
        (progn ; -L109
          (cond ; -L110
            ((= mode 0) ; -L111
              (progn
                (?princ "\n")
                (?princ *Уровень-Рекурсии*)
                (setq iGraf *Уровень-Рекурсии* iStr "")
                (while (> iGraf 0) ; -L117
                  (?princ "\t")
                  (setq iGraf (- iGraf 1))
                ) ;end while L120
                (?princ "-->")
                (?princ (car Элемент))
                (setq @Per (nth 2 (cadr (cadr Элемент)))
                      @Per-End nil
                ) ;end setq L127
                (?princ "\t")
                (foreach @Per-1 @Per
                  (if (AND (NULL @Per-End) (/= @Per-1 '/)) ; -L132
                    (progn ; -L133
                      (?princ "[")
                      (?princ @Per-1)
                      (?princ "]")
                    ) ;end progn L137
                    (setq @Per-End t)
                  ) ;end if L139
                ) ;end foreach L140
                (?princ "\tУсловие:")
                (?princ (cddr (caar (cdr Элемент))))
              ) ;end progn L144
            ) ;end cond case L145
            ((= mode 1) (?princ "- Условие не выполнено"))
            ((= mode 2) (?princ "- Условие выполнено"))
            ((= mode 3) (progn (?princ "\n") (?princ Элемент)))
            ((= mode 4) ; -L150
              (if (/= (type (cadr Элемент)) 'LIST) ; -L151
                (progn ; -L152
                  (?princ "\n====== Результат =======")
                  (?princ "\t")
                  (?princ (cadr Элемент))
                ) ;end progn L156
              ) ;end if L157
            ) ;end cond case L158
          ) ;end cond L159
          (setq s (getvar "DATE"))
          (setq seconds1 (* 86400.0 (- s (fix s))))
          (?princ "Time:")
          (?princ (* (- seconds1 *Seconds-L*) 100))
          (setq *Seconds-L* seconds1)
        ) ;end progn L167
      ) ;end if L168
    ) ;end progn L107
  ) ;end ?catch L106
) ;end defun Print-IGraf L105
(?log "L: 182 Project-4.lsp Print-IGraf Инициализировать-Отладку ")

