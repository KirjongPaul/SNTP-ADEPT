(defun Сортировать-Правила-По-Стратегии (Список-Правил Стратегия) ; -L1706
  "Сортировка правил согласно стратегии разрешения конфликтов
  
  Параметры:
    Список-Правил - список правил для сортировки
    Стратегия - стратегия сортировки:
      'Порядок-Салютности - по приоритету (убывание)
      'Порядок-Времени - по времени активации (FIFO)
      'Порядок-Списка - по порядку в списке (текущая реализация)
      'Случайный - случайный порядок
      'Все-Правила - выполнить все правила
  
  Возвращает: отсортированный список правил"
  (?catch "i: 1719 cond Project-4.lsp " '; -L1719
    (cond ; -L1720
      ((= Стратегия 'Порядок-Салютности) ; -L1721
        ; Сортировка по убыванию приоритета
        (?catch "i: 1723 vl-sort Project-4.lsp " '; -L1723
          (vl-sort Список-Правил
            (function (lambda (П1 П2) ; -L1725
              (> (Получить-Салютность (car П1))
                 (Получить-Салютность (car П2)))
            )) ;end lambda L1728
          )
        ) ;end ?catch L1730
      ) ;end cond case L1731
      ((= Стратегия 'Порядок-Времени) ; -L1732
        ; FIFO - первое пришедшее правило первым выполняется
        Список-Правил  ; Уже в правильном порядке
      ) ;end cond case L1735
      ((= Стратегия 'Порядок-Списка) ; -L1736
        ; Текущая реализация - порядок в списке
        Список-Правил
      ) ;end cond case L1739
      ((= Стратегия 'Случайный) ; -L1740
        ; Перемешивание списка
        (?catch "i: 1742 vl-sort Project-4.lsp " '; -L1742
          (vl-sort Список-Правил
            (function (lambda (П1 П2) ; -L1744
              (< (random 100) (random 100))
            )) ;end lambda L1746
          )
        ) ;end ?catch L1748
      ) ;end cond case L1749
      ((= Стратегия 'Все-Правила) ; -L1750
        ; Все правила будут выполнены
