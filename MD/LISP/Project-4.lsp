;===========================================================================
; TRAMPOLINE PATTERN - Итеративные версии функций
;===========================================================================

(defun Poisk-Итеративный (#Данные / ; -L447
                          #Стек-Задач          ; Стек задач для обработки
                          #Текущие-Данные      ; Данные текущей задачи
                          #Атом                ; Текущий атом
                          #Тип-Элемента        ; Тип текущего элемента
                         )
  "Итеративный поиск правила или атрибута в данных (Trampoline Pattern)
  
  Параметры:
    #Данные - начальные данные для поиска
  
  Возвращает: найденный элемент через глобальную переменную ЭлементRet
  
  Алгоритм:
    1. Создаем стек задач с начальными данными
    2. Пока стек не пуст и результат не найден:
       a. Берем задачу из стека
       b. Обрабатываем задачу
       c. Если нужно продолжить поиск, добавляем новые задачи в стек
    3. Результат сохраняется в глобальной переменной ЭлементRet"
  
  (?catch "i: 448 Poisk-Итеративный Project-4.lsp " '; -L448
    (progn ; -L449
      ; Инициализация
      (setq #Стек-Задач (list #Данные)
            ЭлементRet nil              ; Результат еще не найден
            Список-Данных nil           ; Инициализация списка данных
            Список-Правил nil           ; Инициализация списка правил
      ) ;end setq L455
      
      ; Основной цикл обработки
      (while (and #Стек-Задач (NULL ЭлементRet)) ; -L458
        (progn ; -L459
          ; Извлечение текущей задачи из стека (LIFO - Last In First Out)
          (setq #Текущие-Данные (car #Стек-Задач)
                #Стек-Задач (cdr #Стек-Задач)
          ) ;end setq L463
          
          ; Обработка текущей задачи
          (if (and (NULL ЭлементRet) (= (type #Текущие-Данные) 'LIST)) ; -L466
            (progn ; -L467
              (setq #Атом (car #Текущие-Данные)
                    #Тип-Элемента (type #Атом)
              ) ;end setq L470
              
              (cond ; -L472
                ; СЛУЧАЙ 1: Обработка символа
                ((= #Тип-Элемента 'SYM) ; -L474
                  (progn ; -L475
                    ; Добавляем данные в список
                    (setq Список-Данных (cons #Текущие-Данные Список-Данных))
                    
                    (cond ; -L479
                      ; Найден искомый элемент
                      ((= #Атом Элемент) ; -L481
                       (setq ЭлементRet #Текущие-Данные)
                      ) ;end cond case L483
                      
                      ; Обработка классов (добавление в список правил)
                      ((and (NOT (atom (cadr #Текущие-Данные))) ; -L486
                            (setq Список-Правил
                              (if (and (NULL (assoc #Атом Список-Правил)) ; -L488
                                       (assoc #Атом *Общий-Список-Классов*)) ; -L489
                                (cons (list #Атом) Список-Правил)
