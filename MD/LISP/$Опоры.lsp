));end

;_________________________________________________________________________________
(Defun Кратность ( Расстояние Величина  )
 
	      (* Величина (fix (/ Расстояние  Величина)))
)
;_________________________________________________________________________________
(Defun Добавить-Опору ( PX Тип-Опоры / Опоры Начало )
	;Текущий-Участок
     (if (= Тип-Опоры 'Опора-Н )(setq Общая-Длина-Z-Компенсатора 0.0))
     (setq Опоры  	(>> Текущий-Участок 'Опоры  )
	   Начало (car  (>> Текущий-Участок 'Начало ))
	   Опоры (cons (list 'Опора
			     	(list
				     (List 'Px (+ Начало Px))
				     (List 'Тип-Опоры  Тип-Опоры) ;Угловая, неподвижная , рядовая
				);end list
			)
		       Опоры
		 );end cons
     );end setq
     (Subst-Текущий-Участок (list 'Опоры Опоры))
);end defun
;_________________________________________________________________________________
(defun Разметка-Опор (Начальное-Смещение Расстояние Шаг-Основных-Опор Тип-Опоры Расставлять-Равномерно-? По-Краям-Опоры-? )
    ; Ву-Начало Ву-Конец
    ; расстояние принято на 5% больше с целью уменьшения запаса на границе шаг - расстояние при [ количестве шагов < 1 ]
   (if (and (not (NULL Расстояние )) (> (- Расстояние (* Расстояние 0.05 ))  Шаг-Основных-Опор) ) ;не последний участок;
       
	(progn 
		;Расстановка основных опор
	     	(if (not (Null Расставлять-Равномерно-?))
		    (progn
			 	(setq Шаг-Основных-Опор (Кратность (/ Расстояние (+ (fix (/ Расстояние Шаг-Основных-Опор)) 1)) 0.1))
		    );end progn
		);end if
		    
  		(setq Кол-Шагов  (fix (/ Расстояние Шаг-Основных-Опор))
		      Кратно-2  (if (= (* (fix (/ Кол-Шагов 2)) 2) Кол-Шагов) t nil)
		);end setq
	     	(if (Null  По-Краям-Опоры-? )
		    (progn
  			 (cond
				((and (= Кол-Шагов 0) (> Расстояние Шаг-Угловых-Опор))
			 		;угловой участок, длина участка больше максимального углового шага опор
			 		;расстановка
			 		(Добавить-Опору (/ Расстояние 2) Тип-Опоры)
			 	)
			 	((> Кол-Шагов 1)
				 	(setq i 0 Begin-Px (Кратность (- (/ Расстояние 2) (* (/ Кол-Шагов 2) Шаг-Основных-Опор)) 0.1 ))
		 		 	(while (<= i Кол-Шагов)
					 	(Добавить-Опору (/ (* (+ Начальное-Смещение  Begin-PX  (* i Шаг-Основных-Опор )) 1000.0) Mhx) Тип-Опоры )
					   (setq i ( + i 1 ))
					);end while
				)
			 );end cond
		   );end progn
		    (progn
  			 (cond
			 	((> Кол-Шагов 1)
				 	(setq i 1 Begin-Px (Кратность (- (/ Расстояние 2) (* (/ Кол-Шагов 2) Шаг-Основных-Опор)) 0.1 ))
		 		 	(while (< i Кол-Шагов)
					 	(Добавить-Опору (/ ( * (+ Начальное-Смещение  Begin-PX  (* i Шаг-Основных-Опор )) 1000.0 ) Mhx) Тип-Опоры )
					   (setq i ( + i 1 ))
					);end while
				)
			 );end cond
		    );end progn
		);end if
	 );end progn
    );end if
);end defun
;_________________________________________________________________________________