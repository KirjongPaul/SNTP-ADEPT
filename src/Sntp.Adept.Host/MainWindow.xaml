<Window x:Class="Sntp.Adept.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SNTP-ADEPT"
        Height="900" Width="1440"
        MinHeight="640" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="#1B2A41">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" Background="#132033" Foreground="#C9D6E5">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Запуск…"/>
            </StatusBarItem>
        </StatusBar>
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#F4F1EA"/>
    </DockPanel>
</Window>
